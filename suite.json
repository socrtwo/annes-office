{
  "$comment": "The apps Anne's Office bundles, where their releases live, and how each release names its files. scripts/resolve.mjs reads this. Patterns are regular expressions matched against release asset names; {v} is the app's version (the tag without a leading v and without a -build.N suffix) and {tag} the full tag. Each pattern accepts both the Quill… and the Annes… file-name prefix, so an app can rename its release files without breaking the bundle. The keys (QuillPen…) are internal identifiers and stay as they are.",
  "owner": "socrtwo",
  "apps": {
    "QuillPen": {
      "include": true,
      "repo": "annes-pen",
      "label": "Anne's Pen",
      "summary": "Word processor",
      "id": "io.github.socrtwo.quillpen",
      "assets": {
        "win-x64": "^(?:Quill|Annes)Pen-{v}-windows-x64-setup\\.exe$",
        "win-arm64": "^(?:Quill|Annes)Pen-{v}-windows-arm64-setup\\.exe$",
        "win-portable": "^(?:Quill|Annes)Pen-{v}-windows-portable\\.exe$",
        "mac": "^(?:Quill|Annes)Pen-{v}-mac-universal\\.zip$",
        "linux-deb-x64": "^(?:Quill|Annes)Pen-{v}-linux-amd64\\.deb$",
        "linux-deb-arm64": "^(?:Quill|Annes)Pen-{v}-linux-arm64\\.deb$",
        "linux-deb-armv7l": "^(?:Quill|Annes)Pen-{v}-linux-armv7l\\.deb$",
        "linux-appimage-x64": "^(?:Quill|Annes)Pen-{v}-linux-x86_64\\.AppImage$",
        "linux-appimage-arm64": "^(?:Quill|Annes)Pen-{v}-linux-arm64\\.AppImage$",
        "linux-appimage-armv7l": "^(?:Quill|Annes)Pen-{v}-linux-armv7l\\.AppImage$",
        "android": "^(?:Quill|Annes)Pen-{v}\\.apk$",
        "ios": "^(?:Quill|Annes)Pen-{v}-ios-unsigned\\.ipa$",
        "web": "^(?:Quill|Annes)Pen-{v}-web\\.zip$",
        "sums": "^SHA256SUMS\\.txt$"
      }
    },
    "QuillGrid": {
      "include": true,
      "repo": "annes-grid",
      "label": "Anne's Grid",
      "summary": "Spreadsheet",
      "id": "io.github.socrtwo.quillgrid",
      "assets": {
        "win-x64": "^(?:Quill|Annes)Grid-{v}-windows-x64-setup\\.exe$",
        "win-arm64": "^(?:Quill|Annes)Grid-{v}-windows-arm64-setup\\.exe$",
        "win-portable": "^(?:Quill|Annes)Grid-{v}-windows-portable\\.exe$",
        "mac": "^(?:Quill|Annes)Grid-{v}-mac-universal\\.zip$",
        "linux-deb-x64": "^(?:Quill|Annes)Grid-{v}-linux-amd64\\.deb$",
        "linux-deb-arm64": "^(?:Quill|Annes)Grid-{v}-linux-arm64\\.deb$",
        "linux-deb-armv7l": "^(?:Quill|Annes)Grid-{v}-linux-armv7l\\.deb$",
        "linux-appimage-x64": "^(?:Quill|Annes)Grid-{v}-linux-x86_64\\.AppImage$",
        "linux-appimage-arm64": "^(?:Quill|Annes)Grid-{v}-linux-arm64\\.AppImage$",
        "linux-appimage-armv7l": "^(?:Quill|Annes)Grid-{v}-linux-armv7l\\.AppImage$",
        "android": "^(?:Quill|Annes)Grid-{v}\\.apk$",
        "ios": "^(?:Quill|Annes)Grid-{v}-ios-unsigned\\.ipa$",
        "web": "^(?:Quill|Annes)Grid-{v}-web\\.zip$",
        "sums": "^SHA256SUMS\\.txt$"
      }
    },
    "QuillPost": {
      "include": true,
      "repo": "annes-post",
      "label": "Anne's Post",
      "summary": "Email, calendar and contacts",
      "id": "info.socrtwo.quillpost",
      "$comment": "Anne's Post is a Kotlin application. Its desktop installers come from Compose Multiplatform (MSI, DMG, DEB) and are built per architecture: Windows x64, macOS Apple silicon, Linux x64 and arm64. Its web edition is a JVM server, and its iOS build is a simulator app, which cannot be installed on a device, so it is not bundled.",
      "assets": {
        "win-x64": "^(?:quill|annes)post-desktop-{tag}-windows-x64\\.msi$",
        "win-portable": "^(?:quill|annes)post-desktop-{tag}-windows-x64-portable\\.zip$",
        "mac": "^(?:quill|annes)post-desktop-{tag}-macos-arm64\\.dmg$",
        "linux-deb-x64": "^(?:quill|annes)post-desktop-{tag}-linux-x64\\.deb$",
        "linux-deb-arm64": "^(?:quill|annes)post-desktop-{tag}-linux-arm64\\.deb$",
        "android": "^(?:quill|annes)post-{tag}(-unsigned)?\\.apk$",
        "web": "^(?:quill|annes)post-web-{tag}-any-jvm\\.zip$"
      }
    },
    "QuillStage": {
      "include": true,
      "repo": "annes-stage",
      "label": "Anne's Stage",
      "summary": "Presentations",
      "id": "io.github.socrtwo.quillstage",
      "assets": {
        "win-x64": "^(?:Quill|Annes)Stage-{v}-windows-x64-setup\\.exe$",
        "win-arm64": "^(?:Quill|Annes)Stage-{v}-windows-arm64-setup\\.exe$",
        "win-portable": "^(?:Quill|Annes)Stage-{v}-windows-portable\\.exe$",
        "mac": "^(?:Quill|Annes)Stage-{v}-mac-universal\\.zip$",
        "linux-deb-x64": "^(?:Quill|Annes)Stage-{v}-linux-amd64\\.deb$",
        "linux-deb-arm64": "^(?:Quill|Annes)Stage-{v}-linux-arm64\\.deb$",
        "linux-deb-armv7l": "^(?:Quill|Annes)Stage-{v}-linux-armv7l\\.deb$",
        "linux-appimage-x64": "^(?:Quill|Annes)Stage-{v}-linux-x86_64\\.AppImage$",
        "linux-appimage-arm64": "^(?:Quill|Annes)Stage-{v}-linux-arm64\\.AppImage$",
        "linux-appimage-armv7l": "^(?:Quill|Annes)Stage-{v}-linux-armv7l\\.AppImage$",
        "android": "^(?:Quill|Annes)Stage-{v}\\.apk$",
        "ios": "^(?:Quill|Annes)Stage-{v}-ios-unsigned\\.ipa$",
        "web": "^(?:Quill|Annes)Stage-{v}-web\\.zip$",
        "sums": "^SHA256SUMS\\.txt$"
      }
    },
    "QuillLoom": {
      "include": true,
      "repo": "annes-loom",
      "label": "Anne's Loom",
      "summary": "Web site editor",
      "id": "io.github.socrtwo.quillloom",
      "$comment": "Anne's Loom has no Android or iOS package yet (its releases point phones to the web app), so those bundles leave it out.",
      "assets": {
        "win-x64": "^(?:Quill|Annes)Loom-{v}-windows-x64-setup\\.exe$",
        "win-arm64": "^(?:Quill|Annes)Loom-{v}-windows-arm64-setup\\.exe$",
        "win-portable": "^(?:Quill|Annes)Loom-{v}-windows-portable\\.exe$",
        "mac": "^(?:Quill|Annes)Loom-{v}-mac-universal\\.zip$",
        "linux-deb-x64": "^(?:Quill|Annes)Loom-{v}-linux-amd64\\.deb$",
        "linux-deb-arm64": "^(?:Quill|Annes)Loom-{v}-linux-arm64\\.deb$",
        "linux-deb-armv7l": "^(?:Quill|Annes)Loom-{v}-linux-armv7l\\.deb$",
        "linux-appimage-x64": "^(?:Quill|Annes)Loom-{v}-linux-x86_64\\.AppImage$",
        "linux-appimage-arm64": "^(?:Quill|Annes)Loom-{v}-linux-arm64\\.AppImage$",
        "linux-appimage-armv7l": "^(?:Quill|Annes)Loom-{v}-linux-armv7l\\.AppImage$",
        "android": "^(?:Quill|Annes)Loom-{v}\\.apk$",
        "ios": "^(?:Quill|Annes)Loom-{v}-ios-unsigned\\.ipa$",
        "web": "^(?:Quill|Annes)Loom-{v}-web\\.zip$",
        "sums": "^SHA256SUMS\\.txt$"
      }
    }
  }
}
